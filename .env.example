# Tradeflow environment — copy to backend/.env and fill in as needed.
# Everything below is optional: with no values set, the app runs on synthetic
# market data, without Redis caching, and with AI features in rules-based mode.

# --- Database (defaults to local Postgres; a full URL wins) ---
# DATABASE_URL=postgresql://user:pass@localhost:5432/tradeflow

# --- App ---
APP_ENV=development
APP_SECRET_KEY=change-me-to-a-long-random-string
CORS_ORIGINS=*

# --- Redis (optional; app degrades gracefully without it) ---
# REDIS_URL=redis://localhost:6379

# --- Groq AI (optional; enables natural-language chart reads & trade reviews) ---
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# --- Market data ---
# "synthetic" (default, offline) or "alpaca" (real data — set the keys below)
MARKET_DATA_PROVIDER=synthetic
# ALPACA_API_KEY=
# ALPACA_API_SECRET=

# --- Live trading (real orders). OFF by default; keep it that way until a
#     broker is connected and reviewed. Paper trading needs none of this. ---
LIVE_TRADING_ENABLED=false
PAPER_STARTING_CASH=100000
